# GitHub fine-grained PAT: repository access + Actions: Read-only
GITHUB_OWNER=castle321
GITHUB_REPO=daily_stock_analysis
GITHUB_TOKEN=github_pat_REPLACE_ME
GITHUB_WORKFLOW_FILE=daily_analysis.yml
RUNS_PER_POLL=100

# Existing OpenClaw Feishu direct-message target
FEISHU_OPEN_ID=ou_REPLACE_ME
OPENCLAW_BIN=/usr/bin/openclaw
OPENCLAW_CHANNEL=feishu
OPENCLAW_HOME=/root

POLL_INTERVAL_SECONDS=120
MAX_MESSAGE_CHARS=3500
LOG_LEVEL=INFO
