[Unit]
Description=DSA GitHub Actions report monitor (OpenClaw Feishu)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dsa-monitor
EnvironmentFile=/opt/dsa-monitor/.env
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 /opt/dsa-monitor/monitor.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/dsa-monitor

[Install]
WantedBy=multi-user.target
